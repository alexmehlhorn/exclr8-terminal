<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless xUnit tests for the Exclr8.Terminal library. Runs
       parser + buffer state on raw byte streams; no Avalonia UI is
       touched, so these tests execute on every platform and don't
       need a display. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The Exclr8.Terminal library references Avalonia, which
         emits a flood of CA1416 platform-compat warnings from Porta.Pty
         when its types are transitively referenced. We don't care
         about those here. -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Exclr8.Terminal\Exclr8.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded real-program byte streams replayed by WorkloadReplayTests.
         CopyToOutputDirectory makes them available under
         bin/<Config>/net10.0/Fixtures/*.bin at test run time. -->
    <None Include="Fixtures\*.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Fixtures\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
